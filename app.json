{
  "expo": {
    "name": "Bookmarks",
    "slug": "bookmarks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bookmarks-icon-v5.png",
    "scheme": "bookmarks",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/bookmarks-icon-v5.png",
      "bundleIdentifier": "com.tadingi.bookmarks"
    },
    "android": {
      "icon": "./assets/images/bookmarks-icon-v5.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFD400",
        "foregroundImage": "./assets/images/bookmarks-icon-v5.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tadingi.bookmarks"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/bookmarks-icon-v5.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ae190101-8503-4737-8006-d07d6462a12d"
      }
    },
    "owner": "tadingi"
  }
}
